{
  "name": "dbz-companions-local",
  "displayName": "DBZ Companions — Visual Fan Prototype",
  "description": "Unofficial local fan prototype: Goku and Vegeta live in a VS Code arena, level up into Super Saiyan forms while you code, hunt Dragon Balls and train in the Time Chamber.",
  "version": "0.10.0",
  "publisher": "local-prototype",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbzCompanions.start",
        "title": "DBZ Companions: Start Coding Session"
      },
      {
        "command": "dbzCompanions.show",
        "title": "DBZ Companions: Show Companion"
      },
      {
        "command": "dbzCompanions.openBeside",
        "title": "DBZ Companions: Open Large Preview"
      },
      {
        "command": "dbzCompanions.throwSenzu",
        "title": "DBZ Companions: Throw Senzu Bean",
        "icon": "$(circle-filled)"
      },
      {
        "command": "dbzCompanions.kiBlast",
        "title": "DBZ Companions: Ki Blast!",
        "icon": "$(zap)"
      },
      {
        "command": "dbzCompanions.enterChamber",
        "title": "DBZ Companions: Enter the Hyperbolic Time Chamber (Focus Session)",
        "icon": "$(watch)"
      },
      {
        "command": "dbzCompanions.leaveChamber",
        "title": "DBZ Companions: Leave the Hyperbolic Time Chamber",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dbzCompanions.changeBackground",
        "title": "DBZ Companions: Change Arena Background",
        "icon": "$(paintcan)"
      },
      {
        "command": "dbzCompanions.addFighter",
        "title": "DBZ Companions: Add Fighter",
        "icon": "$(person-add)"
      },
      {
        "command": "dbzCompanions.removeFighter",
        "title": "DBZ Companions: Remove Fighter"
      },
      {
        "command": "dbzCompanions.chooseFighter",
        "title": "DBZ Companions: Choose Fighter"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbzCompanions",
          "title": "DBZ Companions",
          "icon": "assets/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "dbzArenaPanel",
          "title": "DBZ Arena",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dbzCompanions": [
        {
          "type": "webview",
          "id": "dbzCompanions.view",
          "name": "Your Fighters",
          "icon": "assets/icon.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "dbzCompanions.arena",
          "name": "DBZ Arena",
          "when": "config.dbzCompanions.position == 'explorer'"
        }
      ],
      "dbzArenaPanel": [
        {
          "type": "webview",
          "id": "dbzCompanions.arenaPanel",
          "name": "DBZ Arena",
          "when": "config.dbzCompanions.position != 'explorer'"
        }
      ]
    },
    "configuration": {
      "title": "DBZ Companions",
      "properties": {
        "dbzCompanions.reactToSaves": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when you save a file."
        },
        "dbzCompanions.reactToErrors": {
          "type": "boolean",
          "default": true,
          "description": "React when a new code error appears in the active file."
        },
        "dbzCompanions.position": {
          "type": "string",
          "enum": [
            "panel",
            "explorer"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Bottom panel, next to the terminal (under your code)",
            "Explorer sidebar"
          ],
          "description": "Where the DBZ Arena is shown."
        },
        "dbzCompanions.background": {
          "type": "string",
          "enum": [
            "wasteland",
            "namek",
            "kamehouse",
            "tournament",
            "lookout",
            "night"
          ],
          "default": "wasteland",
          "enumDescriptions": [
            "Rocky wasteland with a Saiyan space pod",
            "Planet Namek: three suns, a green sea and Ajisa trees",
            "Kame House on its beach",
            "Tenkaichi Budokai: the ring, the crowd and the hall",
            "Kami's Lookout, high above the clouds",
            "The wasteland at night, under the moon and stars"
          ],
          "description": "Arena background."
        },
        "dbzCompanions.dragonBalls": {
          "type": "boolean",
          "default": true,
          "description": "Typing code uncovers Dragon Balls in the arena. Collect all seven and Shenron grants a wish."
        },
        "dbzCompanions.showHud": {
          "type": "boolean",
          "default": true,
          "description": "Show the scouter (power level, level and form) and the Dragon Ball tracker on the arena."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "dbzCompanions.addFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@0"
        },
        {
          "command": "dbzCompanions.throwSenzu",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@1"
        },
        {
          "command": "dbzCompanions.kiBlast",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@2"
        },
        {
          "command": "dbzCompanions.enterChamber",
          "when": "(view == dbzCompanions.arena || view == dbzCompanions.arenaPanel) && !dbzCompanions.inChamber",
          "group": "navigation@3"
        },
        {
          "command": "dbzCompanions.leaveChamber",
          "when": "(view == dbzCompanions.arena || view == dbzCompanions.arenaPanel) && dbzCompanions.inChamber",
          "group": "navigation@3"
        },
        {
          "command": "dbzCompanions.changeBackground",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@4"
        },
        {
          "command": "dbzCompanions.chooseFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "fighters@1"
        },
        {
          "command": "dbzCompanions.removeFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "fighters@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbzCompanions.leaveChamber",
          "when": "dbzCompanions.inChamber"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/app.js && node --check media/arena.js && node --check media/world.js && node --check media/shenron.js && node --check media/arena-view.js"
  },
  "files": [
    "extension.js",
    "media",
    "assets",
    "LICENSE-NOTICE.md"
  ]
}
