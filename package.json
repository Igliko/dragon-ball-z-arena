{
  "name": "dragon-ball-arena-vscode",
  "displayName": "Dragon Ball Arena",
  "description": "Unofficial Dragon Ball Z fan extension: Goku and Vegeta live in an arena under your code, power up into Super Saiyan forms while you type, hunt the Dragon Balls and train with you in the Time Chamber.",
  "version": "1.0.0",
  "publisher": "Iglikotsiai",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#162235",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "dragon ball",
    "dragon ball z",
    "dbz",
    "goku",
    "vegeta",
    "super saiyan",
    "anime",
    "pets",
    "companion",
    "focus timer",
    "pomodoro",
    "fun"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbzCompanions.start",
        "title": "Start Coding Session",
        "category": "Dragon Ball Arena"
      },
      {
        "command": "dbzCompanions.show",
        "title": "Show Companion",
        "category": "Dragon Ball Arena"
      },
      {
        "command": "dbzCompanions.openBeside",
        "title": "Open Large Preview",
        "category": "Dragon Ball Arena"
      },
      {
        "command": "dbzCompanions.throwSenzu",
        "title": "Throw Senzu Bean",
        "category": "Dragon Ball Arena",
        "icon": "$(circle-filled)"
      },
      {
        "command": "dbzCompanions.kiBlast",
        "title": "Ki Blast!",
        "category": "Dragon Ball Arena",
        "icon": "$(zap)"
      },
      {
        "command": "dbzCompanions.enterChamber",
        "title": "Enter the Hyperbolic Time Chamber (Focus Session)",
        "category": "Dragon Ball Arena",
        "icon": "$(watch)"
      },
      {
        "command": "dbzCompanions.leaveChamber",
        "title": "Leave the Hyperbolic Time Chamber",
        "category": "Dragon Ball Arena",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dbzCompanions.changeBackground",
        "title": "Change Arena Background",
        "category": "Dragon Ball Arena",
        "icon": "$(paintcan)"
      },
      {
        "command": "dbzCompanions.addFighter",
        "title": "Add Fighter",
        "category": "Dragon Ball Arena",
        "icon": "$(person-add)"
      },
      {
        "command": "dbzCompanions.removeFighter",
        "title": "Remove Fighter",
        "category": "Dragon Ball Arena"
      },
      {
        "command": "dbzCompanions.chooseFighter",
        "title": "Choose Fighter",
        "category": "Dragon Ball Arena"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbzCompanions",
          "title": "Dragon Ball Arena",
          "icon": "assets/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "dbzArenaPanel",
          "title": "Dragon Ball Arena",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "dbzCompanions": [
        {
          "type": "webview",
          "id": "dbzCompanions.view",
          "name": "Your Fighters",
          "icon": "assets/activity.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "dbzCompanions.arena",
          "name": "Dragon Ball Arena",
          "when": "config.dbzCompanions.position == 'explorer'"
        }
      ],
      "dbzArenaPanel": [
        {
          "type": "webview",
          "id": "dbzCompanions.arenaPanel",
          "name": "Dragon Ball Arena",
          "when": "config.dbzCompanions.position != 'explorer'"
        }
      ]
    },
    "configuration": {
      "title": "Dragon Ball Arena",
      "properties": {
        "dbzCompanions.reactToSaves": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when you save a file."
        },
        "dbzCompanions.reactToErrors": {
          "type": "boolean",
          "default": true,
          "description": "React when a new code error appears in the active file."
        },
        "dbzCompanions.position": {
          "type": "string",
          "enum": [
            "panel",
            "explorer"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Bottom panel, next to the terminal (under your code)",
            "Explorer sidebar"
          ],
          "description": "Where the Dragon Ball Arena is shown."
        },
        "dbzCompanions.background": {
          "type": "string",
          "enum": [
            "wasteland",
            "namek",
            "kamehouse",
            "tournament",
            "lookout",
            "night"
          ],
          "default": "wasteland",
          "enumDescriptions": [
            "Rocky wasteland with a Saiyan space pod",
            "Planet Namek: three suns, a green sea and Ajisa trees",
            "Kame House on its beach",
            "Tenkaichi Budokai: the ring, the crowd and the hall",
            "Kami's Lookout, high above the clouds",
            "The wasteland at night, under the moon and stars"
          ],
          "description": "Arena background."
        },
        "dbzCompanions.dragonBalls": {
          "type": "boolean",
          "default": true,
          "description": "Typing code uncovers Dragon Balls in the arena. Collect all seven and Shenron grants a wish."
        },
        "dbzCompanions.showHud": {
          "type": "boolean",
          "default": true,
          "description": "Show the scouter (power level, level and form) and the Dragon Ball tracker on the arena."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "dbzCompanions.addFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@0"
        },
        {
          "command": "dbzCompanions.throwSenzu",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@1"
        },
        {
          "command": "dbzCompanions.kiBlast",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@2"
        },
        {
          "command": "dbzCompanions.enterChamber",
          "when": "(view == dbzCompanions.arena || view == dbzCompanions.arenaPanel) && !dbzCompanions.inChamber",
          "group": "navigation@3"
        },
        {
          "command": "dbzCompanions.leaveChamber",
          "when": "(view == dbzCompanions.arena || view == dbzCompanions.arenaPanel) && dbzCompanions.inChamber",
          "group": "navigation@3"
        },
        {
          "command": "dbzCompanions.changeBackground",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@4"
        },
        {
          "command": "dbzCompanions.chooseFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "fighters@1"
        },
        {
          "command": "dbzCompanions.removeFighter",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "fighters@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbzCompanions.leaveChamber",
          "when": "dbzCompanions.inChamber"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/app.js && node --check media/arena.js && node --check media/world.js && node --check media/shenron.js && node --check media/arena-view.js"
  },
  "files": [
    "extension.js",
    "media",
    "assets/icon.png",
    "assets/activity.svg",
    "*.md"
  ]
}
