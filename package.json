{
  "name": "dbz-companions-local",
  "displayName": "DBZ Companions — Visual Fan Prototype",
  "description": "Unofficial local fan prototype with illustrated Goku and Vegeta, animated training and VS Code reactions.",
  "version": "0.7.0",
  "publisher": "local-prototype",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbzCompanions.start",
        "title": "DBZ Companions: Start Coding Session"
      },
      {
        "command": "dbzCompanions.show",
        "title": "DBZ Companions: Show Companion"
      },
      {
        "command": "dbzCompanions.openBeside",
        "title": "DBZ Companions: Open Large Preview"
      },
      {
        "command": "dbzCompanions.toggleEditorBuddy",
        "title": "DBZ Companions: Toggle Fighters in Editor"
      },
      {
        "command": "dbzCompanions.throwSenzu",
        "title": "DBZ Companions: Throw Senzu Bean",
        "icon": "$(circle-filled)"
      },
      {
        "command": "dbzCompanions.kiBlast",
        "title": "DBZ Companions: Ki Blast!",
        "icon": "$(zap)"
      },
      {
        "command": "dbzCompanions.changeBackground",
        "title": "DBZ Companions: Change Arena Background",
        "icon": "$(paintcan)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbzCompanions",
          "title": "DBZ Companions",
          "icon": "assets/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "dbzArenaPanel",
          "title": "DBZ Arena",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dbzCompanions": [
        {
          "type": "webview",
          "id": "dbzCompanions.view",
          "name": "Your Fighters",
          "icon": "assets/icon.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "dbzCompanions.arena",
          "name": "DBZ Arena",
          "when": "config.dbzCompanions.position == 'explorer'"
        }
      ],
      "dbzArenaPanel": [
        {
          "type": "webview",
          "id": "dbzCompanions.arenaPanel",
          "name": "DBZ Arena",
          "when": "config.dbzCompanions.position != 'explorer'"
        }
      ]
    },
    "configuration": {
      "title": "DBZ Companions",
      "properties": {
        "dbzCompanions.reactToSaves": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when you save a file."
        },
        "dbzCompanions.reactToErrors": {
          "type": "boolean",
          "default": true,
          "description": "React when a new code error appears in the active file."
        },
        "dbzCompanions.editorBuddy": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for fighters inside the code editor (see Editor Fighters)."
        },
        "dbzCompanions.editorFighters": {
          "type": "string",
          "enum": [
            "off",
            "walk",
            "cursor"
          ],
          "default": "off",
          "enumDescriptions": [
            "Keep the editor clean",
            "Walk along the bottom of the visible code",
            "Stand next to the line you are editing"
          ],
          "description": "Show Goku and Vegeta inside the code editor too."
        },
        "dbzCompanions.position": {
          "type": "string",
          "enum": [
            "panel",
            "explorer"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Bottom panel, next to the terminal (under your code)",
            "Explorer sidebar"
          ],
          "description": "Where the DBZ Arena is shown."
        },
        "dbzCompanions.background": {
          "type": "string",
          "enum": [
            "wasteland",
            "namek",
            "kamehouse",
            "night"
          ],
          "default": "wasteland",
          "enumDescriptions": [
            "Rocky wasteland",
            "Planet Namek",
            "Kame House island",
            "Wasteland at night"
          ],
          "description": "Arena background."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "dbzCompanions.throwSenzu",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@1"
        },
        {
          "command": "dbzCompanions.kiBlast",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@2"
        },
        {
          "command": "dbzCompanions.changeBackground",
          "when": "view == dbzCompanions.arena || view == dbzCompanions.arenaPanel",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/app.js && node --check media/arena.js && node --check media/arena-view.js && node --check editor-fighters.js"
  },
  "files": [
    "extension.js",
    "media",
    "assets",
    "LICENSE-NOTICE.md",
    "editor-fighters.js"
  ]
}
